# ============================================================================
# Modo nube (opcional)
#
# Sin este archivo, la aplicación guarda todo en el propio dispositivo y
# funciona sin configurar nada. Al definir estas dos variables pasa a trabajar
# contra una base compartida en Supabase, y todos los entrenadores ven la misma
# información desde su teléfono o tablet.
#
# Cómo obtenerlas: supabase.com → su proyecto → Project Settings → API.
# Antes, ejecute supabase/schema.sql en el SQL Editor y cree las cuentas del
# cuerpo técnico en Authentication → Users.
#
# Copie este archivo como `.env` y complete los valores. La clave "anon" está
# pensada para ir dentro del sitio web: quien la tenga no puede leer nada sin
# haber iniciado sesión, porque las políticas RLS del esquema lo impiden.
# ============================================================================

VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
