---
import Base from '../layouts/Base.astro';
---
<Base titulo="Página no encontrada" noindex>
  <section class="wrap construccion">
    <span class="raya" aria-hidden="true"></span>
    <h1 class="display">No encontramos esta página</h1>
    <p class="lectura">Puede que el enlace esté desactualizado. Vuelve al inicio o escríbenos.</p>
    <div class="acciones">
      <a class="btn btn-primario" href="/">Volver al inicio</a>
      <a class="btn btn-secundario" href="/contacto/">Contacto</a>
    </div>
  </section>
</Base>
