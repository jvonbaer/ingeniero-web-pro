---
import { Image } from 'astro:assets';
import logo from '../assets/logo/animate-logo-color.png';
import { menu, llamadoDona } from '../data/sitio';

const ruta = Astro.url.pathname;
const actual = (href: string) => ruta === href;
const enSeccion = (item: { href: string; hijos?: { href: string }[] }) => actual(item.href) || (item.hijos ?? []).some((h) => actual(h.href));
---
<header class="encabezado-sitio">
  <div class="wrap">
    <a class="marca" href="/" aria-label="Fundación Anímate, inicio">
      <Image src={logo} alt="Anímate" width={240} loading="eager" />
    </a>
    <button class="nav-boton" type="button" aria-expanded="false" aria-controls="nav-principal">Menú</button>
    <nav class="nav" id="nav-principal" aria-label="Principal">
      <ul>
        {menu.map((item) => (
          <li>
            <a href={item.href} aria-current={enSeccion(item) ? 'page' : undefined}>{item.texto}</a>
            {item.hijos && (
              <ul class="submenu">
                {item.hijos.map((h) => (<li><a href={h.href} aria-current={actual(h.href) ? 'page' : undefined}>{h.texto}</a></li>))}
              </ul>
            )}
          </li>
        ))}
        <li><a class="btn btn-primario" href={llamadoDona.href}>{llamadoDona.texto}</a></li>
      </ul>
    </nav>
  </div>
</header>
<script>
  const boton = document.querySelector<HTMLButtonElement>('.nav-boton');
  const nav = document.getElementById('nav-principal');
  boton?.addEventListener('click', () => {
    const abierta = nav?.classList.toggle('abierta') ?? false;
    boton.setAttribute('aria-expanded', String(abierta));
  });
</script>
